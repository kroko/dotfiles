{
  "$schema": "https://opencode.ai/config.json",

  // default model on load
  // ----
  //  bionic
  "model": "lmstudio/qwen/qwen3.8-27b",
  // ----
  // ollama (use rarely because of all the issues with it)
  // "model": "ollama/qwen3.8:27b-mlx",

  // providers
  "providers": {
    // lmstudio is built-in opencode V2 provider with local discovery
    "lmstudio": {
      "name": "LM Studio (Local)",
      "settings": {
        "baseURL": "http://localhost:1234/v1"
      }
    },
    // ollama is built-in opencode V2 provider with local discovery
    "ollama": {
      "name": "Ollama (Local)",
      "settings": {
        "baseURL": "http://localhost:11434/v1",
        "num_ctx": 24576
      }
    }
  }
  // claude via plugin not direct provider
  // "plugins": [
  //   "@khalilgharbaoui/opencode-claude-code-plugin"
  // ]
}
