# → .zshenv, always
# → .zprofile, if login shell
# → .zshrc, if interactive shell
# → .zlogin, if login shell
# → .zlogout, if login shell

# macOS
# this WILL be sourced

# Ubuntu
# this will NOT be sourced, use .zshenv

# ----------------------------------------------------------------
# ----------------------------------------------------------------
# ----------------------------------------------------------------

# echo ".zsh-stage0 -- in"

# ----------------------------------------------------------------
# COMMON
# ----------------------------------------------------------------

# ----------------------------------------------------------------
# Editor
# export EDITOR=vi

# ----------------------------------------------------------------
# local bins
export PATH="$HOME/.local/bin:$PATH"

# ----------------------------------------------------------------
# Node Version Manager
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# ----------------------------------------------------------------
# gpg
export GPG_TTY=`tty`

# ----------------------------------------------------------------
# Composer
export PATH="$HOME/.composer/vendor/bin:$PATH"

# ----------------------------------------------------------------
# uv python

# ----------------------------------------------------------------
# govm for Golang
# https://github.com/sbonaiva/govm
export PATH=$PATH:$HOME/.govm/bin
export GOROOT=$HOME/.govm/go
export GOPATH=$HOME/go
export PATH=$PATH:$HOME/.govm/go/bin

# ----------------------------------------------------------------
# g for Golang
# https://github.com/stefanmaric/g
# export GOPATH="$HOME/.go/go"; export GOROOT="$HOME/.go/root"; export PATH="$GOPATH/bin:$PATH";
# alias govm="$GOPATH/bin/g";

# ----------------------------------------------------------------
# rustup
. "$HOME/.cargo/env" 2>/dev/null

# # ----------------------------------------------------------------
# # Ruby
# export RUBY_CONFIGURE_OPTS="--with-openssl-dir=$(brew --prefix openssl@1.1)"
# export PATH="$HOME/.rbenv/bin:$PATH"
# eval "$(rbenv init -)"

# ----------------------------------------------------------------
# macOS
# ----------------------------------------------------------------
if [[ $(uname) == "Darwin" ]]; then
  # ----------------------------------------------------------------
  # Some Homebrew stuff
  export PATH="/usr/local/sbin::$PATH"

  # ----------------------------------------------------------------
  # Homebrew x64
  # all under /usr/local

  # ----------------------------------------------------------------
  # Homebrew arm64
  export PATH="/opt/homebrew/bin:$PATH"

  # ----------------------------------------------------------------
  # VS Code
  export PATH="/Applications/Visual Studio Code.app/Contents/Resources/app/bin:$PATH"

  # # ----------------------------------------------------------------
  # # Qt
  # export PATH="/usr/local/sbin:$PATH"
  # export PATH="/usr/local/opt/qt/bin:$PATH"

  # # ----------------------------------------------------------------
  # Setting PATH for Python 2.7
  # The original version is saved in .zprofile.pysave
  export PATH="/Library/Frameworks/Python.framework/Versions/2.7/bin:${PATH}"

  # ----------------------------------------------------------------
  # STM32
  export STM32CubeMX_PATH=/Applications/STMicroelectronics/STM32CubeMX.app/Contents/Resources

# ----------------------------------------------------------------
# Debian Ubuntu
# ----------------------------------------------------------------
elif command -v apt > /dev/null; then

  # ----------------------------------------------------------------

  export LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH

# ----------------------------------------------------------------
# Unknown
# ----------------------------------------------------------------
else
    echo 'Unknown OS!'
fi



# # ----------------------------------------------------------------

# echo ".zsh-stage0 -- out"