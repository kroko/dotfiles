
# echo ".zsh-stage3 -- in"

# ----------------------------------------------------------------
# COMMON
# ----------------------------------------------------------------

# ----------------------------------------------------------------
printf '\e[45m%*s\e[49m\n' "${COLUMNS:-$(tput cols)}" ''
echo "NVM"
if command_exists nvm ; then
    echo "Listing local"
    nvm list
else
    echo "NOT FOUND"
fi

# ----------------------------------------------------------------
printf '\e[45m%*s\e[49m\n' "${COLUMNS:-$(tput cols)}" ''
echo "pyenv"
echo "Listing versions"
eval "$(pyenv init -)"
pyenv versions

# ----------------------------------------------------------------
# printf '\e[45m%*s\e[49m\n' "${COLUMNS:-$(tput cols)}" ''
# echo "Listing pyenv virtualenvs"
# pyenv virtualenvs
# echo "Use 'pyenv activate <envname>' to activate"

# ----------------------------------------------------------------
printf '\e[45m%*s\e[49m\n' "${COLUMNS:-$(tput cols)}" ''
echo "go"
if command_exists govm ; then
    echo "Listing versions"
    govm list
else
    echo "NOT FOUND"
fi

# ----------------------------------------------------------------
printf '\e[45m%*s\e[49m\n' "${COLUMNS:-$(tput cols)}" ''
echo "Rust"
if command_exists rustup ; then
    echo "Listing:"
    rustup show 2>/dev/null
    cargo --version 2>/dev/null
else
    echo "NOT FOUND"
fi

# # ----------------------------------------------------------------
# printf '\e[45m%*s\e[49m\n' "${COLUMNS:-$(tput cols)}" ''
# echo "Listing ruby versions"
# rbenv versions
# echo "Listing ruby version set"
# rbenv version
# echo "Listing current ruby global"
# rbenv global

# ----------------------------------------------------------------
printf '\e[45m%*s\e[49m\n' "${COLUMNS:-$(tput cols)}" ''
echo "GPG"
# in zprofile export GPG_TTY=`tty`
if command_exists gpgconf ; then
    gpgconf --launch gpg-agent
    echo "Launching"
else
    echo "NOT FOUND"
fi

# ----------------------------------------------------------------
# macOS
# ----------------------------------------------------------------
if [[ $(uname) == "Darwin" ]]; then

  # ----------------------------------------------------------------
  printf '\e[45m%*s\e[49m\n' "${COLUMNS:-$(tput cols)}" ''
  echo "Docker"
  if command_exists docker ; then
      echo "Listing containers"
      docker container ls
  else
      echo "NOT FOUND"
  fi

  # ----------------------------------------------------------------
  printf '\e[45m%*s\e[49m\n' "${COLUMNS:-$(tput cols)}" ''
  figlet kroko @ macos 2>/dev/null

# ----------------------------------------------------------------
# Debian Ubuntu
# ----------------------------------------------------------------
elif command -v apt > /dev/null; then

  # ----------------------------------------------------------------
  printf '\e[45m%*s\e[49m\n' "${COLUMNS:-$(tput cols)}" ''
  echo "Docker"
  if command_exists docker ; then
    if [ $EUID -eq 0 ] || (groups | grep docker); then
      echo "Listing containers"
      docker container ls
    else
      echo "No permissions for Docker"
    fi
  else
      echo "NOT FOUND"
  fi

  # ----------------------------------------------------------------
  printf '\e[45m%*s\e[49m\n' "${COLUMNS:-$(tput cols)}" ''
  figlet kroko @ debian 2>/dev/null

# ----------------------------------------------------------------
# Unknown
# ----------------------------------------------------------------
else
  # ----------------------------------------------------------------
  printf '\e[45m%*s\e[49m\n' "${COLUMNS:-$(tput cols)}" ''
  figlet kroko @ unknown 2>/dev/null
fi

# echo ".zsh-stage3 -- out"