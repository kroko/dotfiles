
# echo ".zsh-stage3 -- in"

# ----------------------------------------------------------------
# COMMON
# ----------------------------------------------------------------

# ----------------------------------------------------------------
printf '\e[45m%*s\e[49m\n' "${COLUMNS:-$(tput cols)}" ''
echo "node.js (via nvm)"
if command_exists nvm ; then
    echo "Listing local"
    nvm list
else
    echo "NOT FOUND"
fi

# ----------------------------------------------------------------
printf '\e[45m%*s\e[49m\n' "${COLUMNS:-$(tput cols)}" ''
echo "python (via uv)"
if command_exists uv; then
    # https://docs.astral.sh/uv/getting-started/installation/
    eval "$(uv generate-shell-completion zsh)"
    eval "$(uvx --generate-shell-completion zsh)"
    uv --version
    uv python list
else
    echo "NOT FOUND"
fi

# ----------------------------------------------------------------
printf '\e[45m%*s\e[49m\n' "${COLUMNS:-$(tput cols)}" ''
echo "go (via govm)"
if command_exists govm && command_exists go; then
    echo "Listing instaled versions"
    govm list | grep -oE '\*[[:space:]]*go[^[:space:]]+' | sed 's/.*go/go/'
    echo "Current in env"
    go version
else
    echo "NOT FOUND"
fi

# ----------------------------------------------------------------
printf '\e[45m%*s\e[49m\n' "${COLUMNS:-$(tput cols)}" ''
echo "rust (via rustup)"
if command_exists rustup ; then
    echo "Listing:"
    rustup show 2>/dev/null
    cargo --version 2>/dev/null
else
    echo "NOT FOUND"
fi

# # ----------------------------------------------------------------
# printf '\e[45m%*s\e[49m\n' "${COLUMNS:-$(tput cols)}" ''
# echo "Listing ruby versions"
# rbenv versions
# echo "Listing ruby version set"
# rbenv version
# echo "Listing current ruby global"
# rbenv global

# ----------------------------------------------------------------
printf '\e[45m%*s\e[49m\n' "${COLUMNS:-$(tput cols)}" ''
echo "GPG"
# in zprofile export GPG_TTY=`tty`
if command_exists gpgconf ; then
    gpgconf --launch gpg-agent
    echo "Launching"
else
    echo "NOT FOUND"
fi

# ----------------------------------------------------------------
# macOS
# ----------------------------------------------------------------
if [[ $(uname) == "Darwin" ]]; then

  # ----------------------------------------------------------------
  printf '\e[45m%*s\e[49m\n' "${COLUMNS:-$(tput cols)}" ''
  echo "Docker"
  if command_exists docker ; then
      echo "Listing containers"
      docker container ls
  else
      echo "NOT FOUND"
  fi

  # ----------------------------------------------------------------
  printf '\e[45m%*s\e[49m\n' "${COLUMNS:-$(tput cols)}" ''
  figlet kroko @ macos 2>/dev/null

# ----------------------------------------------------------------
# Debian Ubuntu
# ----------------------------------------------------------------
elif command -v apt > /dev/null; then

  # ----------------------------------------------------------------
  printf '\e[45m%*s\e[49m\n' "${COLUMNS:-$(tput cols)}" ''
  echo "Docker"
  if command_exists docker ; then
    if [ $EUID -eq 0 ] || (groups | grep docker &> /dev/null); then
      echo "Listing containers"
      docker container ls
    else
      echo "No permissions for Docker"
    fi
  else
      echo "NOT FOUND"
  fi

  # ----------------------------------------------------------------
  printf '\e[45m%*s\e[49m\n' "${COLUMNS:-$(tput cols)}" ''
  figlet kroko @ debian 2>/dev/null

# ----------------------------------------------------------------
# Unknown
# ----------------------------------------------------------------
else
  # ----------------------------------------------------------------
  printf '\e[45m%*s\e[49m\n' "${COLUMNS:-$(tput cols)}" ''
  figlet kroko @ unknown 2>/dev/null
fi

# echo ".zsh-stage3 -- out"